# Personal Hub · plantilla de variables de entorno
# Copiar a apps/web/.env.local y apps/worker/.env según corresponda.
# Nunca subir los archivos reales al repositorio.

# ---------- apps/web/.env.local (públicas, sujetas a RLS) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- apps/worker/.env (solo en el Mac mini, chmod 600) ----------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
HUB_USER_ID=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

CRAFT_API_URL=
CRAFT_API_KEY=
CRAFT_SPACE_ID=

# none | claude_cli | anthropic_api
AI_PROVIDER=none
AI_MAX_JOBS_PER_DAY=20

BACKUP_DIR=
TZ=Europe/Madrid
